{
  "name": "launchdeck",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Turn your Launchpad into a programmable control surface for anything.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "tauri",
    "check": "node scripts/check.mjs",
    "check:web": "node scripts/check.mjs --web",
    "check:full": "node scripts/check.mjs --full",
    "check:arch": "node scripts/check-architecture.mjs",
    "versions:check": "node scripts/check-versions.mjs",
    "docs:links": "node scripts/check-docs-links.mjs",
    "rust:fmt": "node scripts/cargo.mjs fmt --check",
    "rust:check": "node scripts/cargo.mjs check --all-targets",
    "rust:clippy": "node scripts/cargo.mjs clippy --all-targets -- -D warnings",
    "rust:test": "node scripts/cargo.mjs test --no-fail-fast",
    "plugins:build": "sh scripts/build-example-plugins.sh",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
