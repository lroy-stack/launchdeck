{
  "format": "launchdeck.pack",
  "formatVersion": 1,
  "manifest": {
    "author": {
      "name": "LaunchDeck examples"
    },
    "createdWith": {
      "app": "launchdeck",
      "version": "9.9.9"
    },
    "description": "The five starter surfaces of LaunchDeck.",
    "id": "launchdeck-examples.starters",
    "inputs": [
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "lights_webhook",
        "label": "Lights webhook",
        "type": "url"
      },
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "movie_webhook",
        "label": "Movie webhook",
        "type": "url"
      },
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "work_webhook",
        "label": "Work webhook",
        "type": "url"
      },
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "warmer_webhook",
        "label": "Warmer webhook",
        "type": "url"
      },
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "cooler_webhook",
        "label": "Cooler webhook",
        "type": "url"
      },
      {
        "description": "The address of your Home Assistant webhook for this pad.",
        "id": "lock_webhook",
        "label": "Lock webhook",
        "type": "url"
      }
    ],
    "integrity": {
      "content": "sha256:05502111fe0746c8c960d0df084674cf99261c34ba44548da0bcb4c2a19f71cf"
    },
    "license": "MIT",
    "name": "Starters",
    "requirements": {
      "aux": {
        "side": 0,
        "top": 5
      },
      "grid": {
        "minHeight": 8,
        "minWidth": 8
      },
      "rgb": true
    },
    "testedWith": [
      {
        "kind": "virtual",
        "model": "launchpad-x"
      }
    ],
    "version": "1.0.0"
  },
  "content": {
    "contextRules": [
      {
        "application": {
          "identities": [
            {
              "id": "Code",
              "namespace": "x11"
            },
            {
              "id": "com.microsoft.VSCode",
              "namespace": "macos"
            },
            {
              "id": "code.exe",
              "namespace": "windows"
            }
          ],
          "name": "Visual Studio Code"
        },
        "surface": "development"
      },
      {
        "application": {
          "identities": [
            {
              "id": "firefox",
              "namespace": "x11"
            }
          ],
          "name": "Firefox"
        },
        "page": "git",
        "surface": "development"
      }
    ],
    "surfaces": [
      {
        "category": "agents",
        "description": "A physical control surface for autonomous agents. Watch every session at a glance, approve or reject, pause and resume, start a task.",
        "icon": "◉",
        "id": "agent-control",
        "name": "Agent Control",
        "pages": [
          {
            "controls": [
              {
                "description": "Shows the status of one agent session. Press to select it; the command pads then act on it. Long-press dismisses a finished session.",
                "feedback": [
                  {
                    "showFromValue": true,
                    "when": {
                      "is": {
                        "op": "hasValue"
                      },
                      "state": {
                        "args": {
                          "slot": 0
                        },
                        "id": "slot.status",
                        "provider": "agent-control"
                      }
                    }
                  }
                ],
                "icon": "1",
                "id": "g.0.0",
                "label": "Agent 1",
                "longPress": {
                  "action": "dismissSlot",
                  "args": {
                    "slot": 0
                  },
                  "provider": "agent-control"
                },
                "looks": {
                  "approval_required": {
                    "animation": "flash",
                    "color": "#ffffff"
                  },
                  "cancelled": {
                    "color": "#4d0c0f"
                  },
                  "completed": {
                    "color": "#1edc5a"
                  },
                  "empty": {
                    "color": "#0c0d12"
                  },
                  "failed": {
                    "animation": "flash",
                    "color": "#ff2832"
                  },
                  "idle": {
                    "color": "#123273"
                  },
                  "offline": {
                    "color": "#15161b"
                  },
                  "paused": {
                    "color": "#ff7814"
                  },
                  "running": {
                    "animation": "pulse",
                    "color": "#1edc5a"
                  },
                  "starting": {
                    "color": "#ffc81e"
                  },
                  "tool_use": {
                    "animation": "pulse",
                    "color": "#1ed2e6"
                  },
                  "waiting": {
                    "color": "#aa50ff"
                  }
                },
                "pos": {
                  "col": 0,
                  "kind": "grid",
                  "row": 0
                },
                "press": {
                  "action": "focusSlot",
                  "args": {
                    "slot": 0
                  },
                  "provider": "agent-control"
                },
                "visual": {
                  "color": "#0c0d12"
                }
              },
              {
                "description": "Lit while this track is selected. Press to select it.",
                "feedback": [
                  {
                    "show": "focused",
                    "when": {
                      "is": {
                        "op": "equals",
                        "value": true
                      },
                      "state": {
                        "args": {
                          "slot": 0
                        },
                        "id": "slot.focused",
                        "provider": "agent-control"
                      }
                    }
                  }
                ],
                "icon": "▲",
                "id": "g.0.1",
                "label": "Select 1",
                "looks": {
                  "focused": {
                    "color": "#ffffff"
                  }
                },
