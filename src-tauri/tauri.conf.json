{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaunchDeck",
  "identifier": "dev.launchdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LaunchDeck",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#0b0c10",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Turn your Launchpad into a programmable control surface.",
    "longDescription": "LaunchDeck turns a Novation Launchpad into a programmable control surface for your computer: pads open applications, press shortcuts, send requests and switch pages, light up to show the state of things, follow the application in front and put AI agents on the pads. A simulated Launchpad is built in.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../examples/plugins/hello/plugin.json": "examples/plugins/hello/plugin.json",
      "../examples/plugins/hello/hello.wasm": "examples/plugins/hello/hello.wasm",
      "../examples/plugins/counter/plugin.json": "examples/plugins/counter/plugin.json",
      "../examples/plugins/counter/counter.wasm": "examples/plugins/counter/counter.wasm",
      "../examples/plugins/home-assistant/plugin.json": "examples/plugins/home-assistant/plugin.json",
      "../examples/plugins/home-assistant/home-assistant.wasm": "examples/plugins/home-assistant/home-assistant.wasm"
    }
  }
}
